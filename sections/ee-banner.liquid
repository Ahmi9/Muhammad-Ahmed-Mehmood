{%- comment -%}
  gift guide banner. top top bar becomes a hamburger menu under 750px, mobile image / text / strip are optional and fall back to desktop
{%- endcomment -%}
{{ 'ee-banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ee-banner.js' | asset_url }}" defer></script>

{%- liquid
    assign font_medium = section.settings.font | font_modify: 'weight', '500'
-%}

<style>
    {{ section.settings.font | font_face: font_display: 'swap' }}
    {{ font_medium | font_face: font_display: 'swap' }}
    .ee-banner {
        --ee-font: {{ section.settings.font.family }}, {{ section.settings.font.fallback_families }};
    }
</style>

<section class="ee-banner">
    <div class="ee-banner__topbar">
        <button type="button" class="ee-banner__toggle" aria-expanded="false" aria-controls="EeBannerMenu-{{ section.id }}" aria-label="Open menu" data-ee-menu-toggle>
            <svg class="ee-banner__icon-open" width="18" height="12" viewBox="0 0 18 12" aria-hidden="true">
                <path d="M0 1h18M0 6h18M0 11h18" stroke="currentColor" stroke-width="2"/>
            </svg>
            <svg class="ee-banner__icon-close" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="1.5"/>
            </svg>
        </button>
        <span class="ee-banner__brand">{{ section.settings.brand }}</span>

        <div class="ee-banner__menu" id="EeBannerMenu-{{ section.id }}">
            <p class="ee-banner__tagline">{{ section.settings.tagline }}</p>
            {%- if section.settings.top_button_label != blank -%}
                <a href="{{ section.settings.top_button_link | default: '#' }}" class="ee-btn ee-btn--yellow">
                    <span class="ee-btn__label">{{ section.settings.top_button_label }}</span>
                    {%- render 'ee-arrow' -%}
                </a>
            {%- endif -%}
        </div>
    </div>

    <div class="ee-banner__hero">
        {%- if section.settings.background != blank -%}
            <picture class="ee-banner__picture">
                {%- if section.settings.background_mobile != blank -%}
                    <source media="(max-width: 749px)" srcset="{{ section.settings.background_mobile | image_url: width: 750 }} 750w, {{ section.settings.background_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
                {%- endif -%}
                {{ section.settings.background | image_url: width: 2400 | image_tag: class: 'ee-banner__bg', loading: 'eager', sizes: '100vw', alt: ''}}
            </picture>
        {%- endif -%}
        <div class="ee-banner__content">
            <h1 class="ee-banner__heading">{{ section.settings.heading }}</h1>
            <div class="ee-banner__text{%  if section.settings.text_mobile != blank %} ee-banner__text--desktop{% endif %}">{{ section.settings.text }}</div>
            {%- if section.settings.text_mobile != blank -%}
                <div class="ee-banner__text ee-banner__text--mobile">{{ section.settings.text_mobile }}</div>
            {%- endif -%}

            {%- if section.settings.button_label != blank -%}
                <a href="{{ section.settings.button_link | default: '#' }}" class="ee-btn ee-btn--black">
                    <span class="ee-btn__label">{{ section.settings.button_label }}</span>
                    {%- render 'ee-arrow' -%}
                </a>
            {%- endif -%}
        </div>
    </div>

    {%- if section.settings.strip_text != blank -%}
      <p class="ee-banner__strip">
        <span class="ee-banner__strip-text{% if section.settings.strip_text_mobile != blank %} ee-banner__strip-text--desktop{% endif %}">{{ section.settings.strip_text }}</span>
        {% if section.settings.strip_text_mobile !=blank %}
            <span class="ee-banner__strip-text ee-banner__strip-text--mobile">{{ section.settings.strip_text_mobile }}</span>
        {% endif %}
      </p>
    {%- endif -%}

</section>

{% schema %}
{
    "name": "EE Banner",
    "tag": "div",
    "class": "ee-banner-section",
    "settings": [
        {
        "type": "font_picker",
        "id": "font",
        "label": "Font",
        "default": "jost_n4"
        },
        {
        "type": "header",
        "content": "Top bar"
        },
        {
        "type": "text",
        "id": "brand",
        "label": "Brand name",
        "default": "TISSO VISON"
        },
        {
        "type": "text",
        "id": "tagline",
        "label": "Tagline",
        "default": "Find the ideal gift for your loved ones."
        },
        {
        "type": "text",
        "id": "top_button_label",
        "label": "Button label",
        "default": "CHOOSE GIFT"
        },
        {
        "type": "url",
        "id": "top_button_link",
        "label": "Button link"
        },
        {
        "type": "header",
        "content": "Hero"
        },
        {
        "type": "image_picker",
        "id": "background",
        "label": "Background image"
        },
        {
        "type": "image_picker",
        "id": "background_mobile",
        "label": "Mobile background image",
        "info": "Optional. Shown below 750px instead of the desktop image."
        },
        {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "The Gift Guide"
        },
        {
        "type": "richtext",
        "id": "text",
        "label": "Text",
        "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
        },
        {
        "type": "text",
        "id": "button_label",
        "label": "Button label",
        "default": "SHOP NOW"
        },
        {
            "type": "richtext",
            "id": "text_mobile",
            "label": "Mobile text",
            "info": "Optional. Shown below 750px instead of the text above.",
            "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination</p>"
        },
        {
        "type": "url",
        "id": "button_link",
        "label": "Button link"
        },
        {
            "type": "header",
            "content": "Bottom strip"
        },
        {
            "type": "text",
            "id": "strip_text",
            "label": "Strip text",
            "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
        },
        {
            "type": "text",
            "id": "strip_text_mobile",
            "label": "Mobile strip text",
            "info": "Optional. Shown below 750px instead of the text above.",
            "default": "SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR"
        }
    ],
    "presets": [{ "name": "EE Banner" }]
}
{% endschema %}
